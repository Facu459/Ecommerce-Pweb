<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mi Ecommerce - Registro</title>
    <!-- Importamos la fuente Poppins -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Vinculamos nuestro CSS externo -->
    <link rel="stylesheet" href="/css/styles.css">
    
</head>

<body>
    <%- include('../partials/header', { hideMenu: true }) %>
    <%- include('../partials/header') %>
    
    <main class="main-centrado">
        <section class="registro-contenedor">
            <h1>Registro</h1>
            
            <form action="/" method="GET">
                <!-- Para que funcione el label flotante, el placeholder DEBE ser " " (un espacio) -->
                
                <div class="campo-formulario">
                    <input type="text" id="nombre" name="nombre" placeholder=" " required>
                    <label for="nombre">Nombre completo</label>
                </div>

                <div class="campo-formulario">
                    <input type="email" id="email" name="email" placeholder=" " required>
                    <label for="email">Correo electrónico</label>
                </div>

                <div class="campo-formulario">
                    <input type="password" id="password" name="password" placeholder=" " required>
                    <label for="password">Contraseña</label>
                </div>

                <div class="campo-formulario">
                    <input type="password" id="confirm_password" name="confirm_password" placeholder=" " required>
                    <label for="confirm_password">Confirmar contraseña</label>
                </div>

                <button type="submit">Crear cuenta</button>
            </form>
            
            <div class="enlaces-adicionales">
                <p>¿Ya tienes cuenta? <a href="/login">Inicia Sesión</a></p>
                <p><a href="/">Volver a la tienda</a></p>
            </div>
        </section>    
    </main>

    <%- include('../partials/footer') %>
</body>
</html>