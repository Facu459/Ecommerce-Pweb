<!DOCTYPE html>
<html lang="es">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Mi Ecommerce - Registro</title>
    </head>

    <body>
    <%- include('../partials/header') %>
        <main>
            <section class="registro-contenedor">
                <h1>Registro</h1>
             <!-- formulario -->
             <form action="/register" method="POST">

                <!-- input nombre-->
                <div class="campo-formulario">
                    <label for="nombre">Nombre completo</label>
                    <input type="text" id="nombre" name="nombre" placeholder="Tu nombre" required>
                </div>

                <!-- input email -->
                <div class="campo-formulario"></div>
                    <label for="email">Correo electrónico:</label>
                    <input type="email" id="email" name="email" required>
                </div>

                <!-- input contraseña -->
                <div class="campo-formulario">
                    <label for="password">Contraseña:</label>
                    <input type="password" id="password" name="password" required>
                </div>

                <!-- input confirmar contraseña -->
                 <div class="campo-formulario">
                    <label for="confirm_password">Confirmar contraseña</label>
                    <input type="password" id="confirm_password" name="confirm_password" placeholder="Repite tu contraseña" required>
                </div>

                <!-- boton de registro-->
                <button type="submit">Registrarse</button>
                </form>
                
                <!-- bonus: enlace hacia login -->
                <div class="enlaces-adicionales">
                <p>¿Ya tienes cuenta? <a href="/login">Inicia Sesión</a></p>
                <!-- Enlace de inicio -->
                <p><a href="/">Volver a la página de inicio</a></p>
            </div>

            </section>    
         </main>
           <%- include('../partials/footer') %>
    </body>
