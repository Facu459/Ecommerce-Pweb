<%- include('../partials/header') %>

<!-- Importamos la fuente Poppins -->
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>
    /* Contenedor principal */
    .product-main {
        font-family: 'Poppins', sans-serif;
        max-width: 1200px;
        margin: 40px auto;
        padding: 0 20px;
        color: #333;
        animation: fadeIn 0.8s ease-out;
    }

    /* =========================================
       ESTILOS ESTADO: ERROR / NO ENCONTRADO
       ========================================= */
    .error-not-found {
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(15px);
        -webkit-backdrop-filter: blur(15px);
        border: 1px solid rgba(255, 255, 255, 0.5);
        border-radius: 24px;
        padding: 60px 20px;
        text-align: center;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.05);
        margin-bottom: 50px;
    }

    .error-not-found h1 {
        background: linear-gradient(135deg, #ff7675, #d63031);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        font-size: 2.5rem;
        margin-bottom: 15px;
    }

    /* =========================================
       ESTILOS ESTADO: NORMAL (PRODUCTO)
       ========================================= */
    
    /* Navegación de Categorías tipo píldoras */
    .categories-list {
        display: flex;
        justify-content: center;
        gap: 15px;
        list-style: none;
        padding: 0;
        margin-bottom: 40px;
        flex-wrap: wrap;
    }

    .categories-list a {
        background: rgba(255, 255, 255, 0.6);
        backdrop-filter: blur(10px);
        padding: 10px 25px;
        border-radius: 50px;
        text-decoration: none;
        color: #2d3436;
        font-weight: 500;
        transition: all 0.3s ease;
        border: 1px solid rgba(255, 255, 255, 0.8);
        box-shadow: 0 4px 10px rgba(0,0,0,0.02);
    }

    .categories-list a:hover {
        background: linear-gradient(135deg, #6c5ce7, #a29bfe);
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 8px 15px rgba(108, 92, 231, 0.2);
    }

    /* Layout principal del producto */
    .product-details-layout {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 50px;
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(15px);
        -webkit-backdrop-filter: blur(15px);
        border: 1px solid rgba(255, 255, 255, 0.5);
        border-radius: 24px;
        padding: 40px;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.05);
        margin-bottom: 60px;
        align-items: center;
    }

    .product-gallery img {
        width: 100%;
        border-radius: 20px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.1);
        object-fit: cover;
        transition: transform 0.4s ease;
    }

    .product-gallery img:hover {
        transform: scale(1.02);
    }

    .product-info h1 {
        font-size: 2.2rem;
        line-height: 1.2;
        margin-bottom: 20px;
        color: #2d3436;
    }

    .product-info .description {
        font-size: 1.1rem;
        color: #636e72;
        line-height: 1.6;
        margin-bottom: 30px;
    }

    .product-info .price {
        font-size: 2.5rem;
        font-weight: 700;
        color: #6c5ce7;
        margin-bottom: 30px;
    }

    /* =========================================
       SECCIÓN: PRODUCTOS RELACIONADOS / SUGERIDOS
       ========================================= */
    .products-section h2 {
        text-align: center;
        font-size: 2rem;
        margin-bottom: 30px;
        color: #2d3436;
    }

    .products-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
        gap: 30px;
    }

    .product-card a {
        display: block;
        background: rgba(255, 255, 255, 0.6);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.5);
        border-radius: 20px;
        padding: 20px;
        text-align: center;
        text-decoration: none;
        color: inherit;
        transition: all 0.3s ease;
        box-shadow: 0 10px 20px rgba(0,0,0,0.03);
    }

    .product-card a:hover {
        transform: translateY(-8px);
        box-shadow: 0 15px 30px rgba(108, 92, 231, 0.15);
        background: rgba(255, 255, 255, 0.9);
    }

    .product-card img {
        width: 150px;
        height: 150px;
        object-fit: cover;
        border-radius: 12px;
        margin-bottom: 15px;
    }

    .product-card h3 {
        font-size: 1.1rem;
        margin: 10px 0;
        color: #2d3436;
    }

    .product-card .price-points {
        font-weight: 600;
        color: #6c5ce7;
        font-size: 1.2rem;
    }

    /* =========================================
       BOTONES Y ANIMACIONES
       ========================================= */
    .btn-primary, .btn-outline {
        display: inline-block;
        padding: 15px 35px;
        border-radius: 50px;
        font-weight: 600;
        font-size: 1.1rem;
        cursor: pointer;
        transition: all 0.3s ease;
        border: none;
        text-decoration: none;
        font-family: 'Poppins', sans-serif;
    }

    .btn-primary {
        background: linear-gradient(135deg, #6c5ce7, #a29bfe);
        color: #fff;
        box-shadow: 0 8px 20px rgba(108, 92, 231, 0.3);
        width: 100%;
    }

    .btn-primary:hover {
        transform: translateY(-3px);
        box-shadow: 0 12px 25px rgba(108, 92, 231, 0.4);
    }

    .btn-outline {
        background: transparent;
        border: 2px solid #6c5ce7;
        color: #6c5ce7;
        margin-top: 20px;
    }

    .btn-outline:hover {
        background: rgba(108, 92, 231, 0.05);
        transform: translateY(-2px);
    }

    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }

    /* Responsividad para móviles */
    @media (max-width: 768px) {
        .product-details-layout {
            grid-template-columns: 1fr;
            padding: 25px;
            gap: 30px;
        }
        
        .product-info h1 {
            font-size: 1.8rem;
        }
        
        .product-info .price {
            font-size: 2rem;
        }
    }
</style>

<main class="product-main">

    <% if (error) { %>
        <section class="error-not-found">
            <h1>¡Ups! Producto no encontrado</h1>
            <p>Parece que el artículo que buscas no existe o fue retirado de nuestro catálogo.</p>
            <a href="/" class="btn-outline">Volver a la tienda</a>
        </section>

        <!-- BONUS 2: Productos sugeridos para no perder la venta -->
        <section class="products-section" aria-label="Productos sugeridos">
            <h2>Quizás te interesen estos productos</h2>
            <div class="products-grid">
                <article class="product-card">
                    <a href="/product">
                        <img src="/img/prod-auriculares.jpg" alt="Auriculares">
                        <h3>Auriculares Inalámbricos</h3>
                        <p class="price-points">1500 pts</p>
                    </a>
                </article>
                <!-- Agrega más tarjetas aquí para que se vea como en el inicio -->
            </div>
        </section>

    <% } else { %>
        <!-- ========================================== -->
        <!-- ESTADO NORMAL: PRODUCTO ENCONTRADO         -->
        <!-- ========================================== -->
        
        <!-- BONUS 4: Listado de categorías superior -->
        <nav class="categories-nav" aria-label="Categorías principales">
            <ul class="categories-list">
                <li><a href="/category/electronica">Electrónica</a></li>
                <li><a href="/category/alimentos">Alimentos</a></li>
                <li><a href="/category/bebidas">Bebidas</a></li>
            </ul>
        </nav>

        <!-- Requisitos principales: Detalles del producto -->
        <section class="product-details-layout">
            <!-- Imágenes -->
            <div class="product-gallery">
                <img src="/img/jack-daniels.jpg" alt="Jack Daniel's Tennessee Honey Botella 750 mL" class="main-image">
            </div>
            
            <!-- Info y compra -->
            <div class="product-info">
                <h1>Jack Daniel's Tennessee Honey Botella 750 mL</h1>
                <p class="description">
                    Disfruta del sabor único de Jack Daniel's mezclado con un toque de miel. 
                    Ideal para tomar solo, con hielo o en tus cócteles favoritos.
                </p>
                <p class="price">19.900 pts</p>
                
                <!-- Botón agregar al carrito -->
                <form action="/cart" method="GET">
                    <button type="submit" class="btn-primary">Agregar al Carrito 🛒</button>
                </form>
            </div>
        </section>

        <!-- BONUS 3: Productos Relacionados -->
        <section class="products-section" aria-label="Productos similares">
            <h2>Productos Relacionados</h2>
            <div class="products-grid">
                <article class="product-card">
                    <a href="/product">
                        <img src="/img/combo.jpg" alt="Combo Hamburguesa">
                        <h3>1 Combo Hamburguesa</h3>
                        <p class="price-points">5.000 pts</p>
                    </a>
                </article>
                <article class="product-card">
                    <a href="/product">
                        <img src="/img/coca.jpg" alt="Coca Cola">
                        <h3>Coca Cola Lata 220mL x8</h3>
                        <p class="price-points">1.520 pts</p>
                    </a>
                </article>
            </div>
        </section>

    <% } %>
</main>

<%- include('../partials/footer') %>