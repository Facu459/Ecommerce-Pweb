<!DOCTYPE html>
<html lang="es">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Mi Ecommerce - Home</title>
    </head>

    <body>
    <%- include('../partials/header') %>
        <main>
            
             <%- include('../partials/categories') %>

            <section class= "banners">   
                <article class="banner-disney">   
                    <h3> 50% OFF en Combo Plus </h3>
                     <p> Canjeando 50.000 puntos MiEcommerce</p>
                </article>
                <article class="banner-hbo">   
                    <h3> 50% OFF en HBO MAX </h3>
                     <p> Canjeando 50.000 puntos MiEcommerce</p>
                </article>
            </section>

            <section class="listado">
    <h2>Te puede interesar</h2>
    
    <% suggested.forEach(product => { %>
        <!-- Llamamos al partial pasándole los datos del producto actual -->
        <%- include('../partials/productCard', { product: product }) %>
    <% }) %>
</section>

                    <section class="listado" >
                         <h2>Los más pedidos</h2>
    
                            <div class="products-grid" style="display: flex; gap: 20px; flex-wrap: wrap;"> <!-- O la clase que uses para tu grilla -->
                                <% mostWanted.forEach(product => { %>
                               <!-- Reciclamos el componente exacto de la US6 -->
                             <%- include('../partials/productCard', { product: product }) %>
                             <% }) %>
                            </div>
                    </section>

                  <%- include('../partials/categories') %>

         </main>
           <%- include('../partials/footer') %>
    </body>
</html>
