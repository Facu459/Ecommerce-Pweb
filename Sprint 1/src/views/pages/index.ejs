<!DOCTYPE html>
<html lang="es">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Mi Ecommerce - Home</title>
    </head>

    <body>
    <%- include('../partials/header') %>
        <main>
            
             <%- include('../partials/categories') %>

            <section class= "banners">   
                <article class="banner-disney">   
                    <h3> 50% OFF en Combo Plus </h3>
                     <p> Canjeando 50.000 puntos MiEcommerce</p>
                </article>
                <article class="banner-hbo">   
                    <h3> 50% OFF en HBO MAX </h3>
                     <p> Canjeando 50.000 puntos MiEcommerce</p>
                </article>
            </section>

            <section class="listado">
    <h2>Te puede interesar</h2>
    
    <!-- 1. Tu producto específico -->
    <article>
        <a href="/product">
            <img src="/img/jack-daniels.webp" alt="Whiskey Jack Daniels Honey 750ml">
            <h4>Whiskey Jack Daniels Honey 750ml</h4>
            <p>19.900 Puntos</p>
        </a>
    </article>

    <!-- 2. Los 3 productos genéricos restantes para completar la fila -->
    <% for(let i = 0; i < 3; i++) { %>
    <article>
        <a href="/product">
            <img src="/img/cuadricula.webp" alt="Imagen de prueba del producto">
            <h4>Nombre del Producto</h4>
            <p>xxxxx Puntos</p>
        </a>
    </article>
    <% } %>
</section>

                 <section class="listado">
                    <h2>Los más pedidos</h2>
        
                       
                        <% for(let i = 0; i < 8; i++) { %>
                        <article>
                                <a href="/product">
                                <img src="/img/cuadricula.webp" alt="Imagen de prueba del producto">
                                 <h4>Nombre del Producto</h4>
                                <p>xxxxx Puntos</p>
                               </a>
                        </article>
                     <% } %>
            
                 </section>

                  <%- include('../partials/categories') %>

         </main>
           <%- include('../partials/footer') %>
    </body>
</html>
