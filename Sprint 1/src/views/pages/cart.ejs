<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mi Ecommerce - Carrito</title>
    <!-- Importamos la fuente Poppins -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Vinculamos nuestro CSS externo -->
    <link rel="stylesheet" href="/css/styles.css">
   
</head>
<body>

    <%- include('../partials/header') %>

    <main class="cart-container">
        <h1>Tu Carrito de Compras</h1>
        
        <div class="cart-layout">
            <section class="cart-items" aria-label="Listado de productos agregados">
                
                <article class="cart-item">
                    <img src="/img/prod-auriculares.jpg" alt="Auriculares Inalámbricos">
                    <div class="item-details">
                        <h2>Auriculares Inalámbricos</h2>
                        <p class="item-price">1500 pts</p>
                    </div>
                    
                    <div class="item-quantity">
                        <button type="button" class="btn-qty" aria-label="Quitar una unidad">➖</button>
                        <span class="qty-count" aria-live="polite">1</span>
                        <button type="button" class="btn-qty" aria-label="Agregar una unidad">➕</button>
                    </div>
                    
                    <div class="item-total">
                        <p>Total: <br><strong>1500 pts</strong></p>
                    </div>
                </article>

                <article class="cart-item">
                    <img src="/img/prod-cafetera.jpg" alt="Cafetera Express">
                    <div class="item-details">
                        <h2>Cafetera Express</h2>
                        <p class="item-price">3200 pts</p>
                    </div>
                    
                    <div class="item-quantity">
                        <button type="button" class="btn-qty" aria-label="Quitar una unidad">➖</button>
                        <span class="qty-count" aria-live="polite">2</span>
                        <button type="button" class="btn-qty" aria-label="Agregar una unidad">➕</button>
                    </div>
                    
                    <div class="item-total">
                        <p>Total: <br><strong>6400 pts</strong></p>
                    </div>
                </article>

            </section>

            <aside class="cart-summary" aria-label="Resumen de compra">
                
                <form action="/cart/discount" method="POST" class="discount-form">
                    <label for="discount-code">¿Tienes un cupón?</label>
                    <div class="discount-input-group">
                        <input type="text" id="discount-code" name="discountCode" placeholder="Ej: PROMO2026" aria-label="Ingresar código alfanumérico">
                        <button type="submit" class="btn-secondary">Aplicar</button>
                    </div>
                </form>

                <div class="summary-totals">
                    <p>Total a pagar:</p>
                    <strong>7900 pts</strong>
                </div>

                <div class="cart-actions">
                    <a href="/checkout" class="btn-primary">Ir a Pagar</a>
                    <a href="/" class="btn-outline">Volver al listado</a>
                </div>
            </aside>
        </div>
    </main>

    <%- include('../partials/footer') %>

</body>
</html>