<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mi Ecommerce - Carrito</title>
    <!-- Importamos la fuente Poppins -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Vinculamos nuestro CSS externo -->
    <link rel="stylesheet" href="/css/styles.css">
   
</head>
<body>

    <%- include('../partials/header') %>

    <main class="cart-container">
    <h1>Tu Carrito de Compras</h1>
    
    <!-- Escenario 6: Carrito Vacío -->
    <% if (cart.length === 0) { %>
        <section style="text-align: center; padding: 50px;">
            <h2>Tu carrito está vacío 🛒</h2>
            <p>¡Parece que aún no has agregado nada!</p>
            <br>
            <a href="/products" class="btn-primary">Ir a la tienda</a>
        </section>
    <% } else { %>
        <div class="cart-layout">
            <section class="cart-items">
                <!-- Iteramos sobre los productos del carrito -->
                <% cart.forEach(item => { %>
                    <article class="cart-item">
                        <img src="<%= item.image %>" alt="<%= item.name %>">
                        <div class="item-details">
                            <h2><%= item.name %></h2>
                            <p class="item-price"><%= item.price %> pts c/u</p>
                        </div>
                        
                        <div class="item-quantity">
                            <!-- Botón Restar -->
                            <form action="/cart/update" method="POST" style="display:inline;">
                                <input type="hidden" name="productId" value="<%= item.id %>">
                                <input type="hidden" name="action" value="decrease">
                                <button type="submit" class="btn-qty">-</button>
                            </form>
                            
                            <span class="qty-count"><%= item.quantity %></span>
                            
                            <!-- Botón Sumar -->
                            <form action="/cart/update" method="POST" style="display:inline;">
                                <input type="hidden" name="productId" value="<%= item.id %>">
                                <input type="hidden" name="action" value="increase">
                                <button type="submit" class="btn-qty">+</button>
                            </form>
                        </div>
                        
                        <div class="item-total">
                            <p>Subtotal: <br><strong><%= item.subtotal %> pts</strong></p>
                        </div>
                    </article>
                <% }) %>
            </section>

            <aside class="cart-summary">
                <div class="summary-totals">
                    <p>Total a pagar:</p>
                    <strong><%= total %> pts</strong>
                </div>
                <div class="cart-actions">
                    <a href="/checkout" class="btn-primary">Ir a Pagar</a>
                    
                    <!-- Botón Vaciar -->
                    <form action="/cart/clear" method="POST" style="margin-top: 10px;">
                        <button type="submit" class="btn-outline" style="width: 100%;">Vaciar carrito</button>
                    </form>
                </div>
            </aside>
        </div>
    <% } %>
</main>

    <%- include('../partials/footer') %>

</body>
</html>