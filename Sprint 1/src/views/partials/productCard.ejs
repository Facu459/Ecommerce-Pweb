<article class="producto" style="width: 250px; background: #fff; border-radius: 10px; box-shadow: 0 4px 8px rgba(0,0,0,0.1); padding: 15px; text-align: center; overflow: hidden; display: flex; flex-direction: column;">
    <a href="/products/<%= product.id %>" style="text-decoration: none; color: inherit;">
        
        <!-- Aquí está la magia CSS: width: 100%, height fijo y object-fit: cover -->
        <img src="<%= product.image && product.image.trim() !== '' ? product.image : '/img/cuadricula.webp' %>" 
             alt="<%= product.name %>" 
             style="width: 100%; height: 200px; object-fit: cover; border-radius: 6px; margin-bottom: 12px;">
        
        <h4 style="font-size: 1.1rem; margin: 10px 0; color: #333;"><%= product.name %></h4>
        <p style="font-weight: 600; color: #666; font-size: 1rem;"><%= product.price %> Puntos</p>
    </a>
</article>